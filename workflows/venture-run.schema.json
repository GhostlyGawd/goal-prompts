{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goal Prompts venture run v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "scope",
    "operator",
    "criteria",
    "decisions",
    "commit_preference",
    "next_step",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "stopped",
        "complete"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "operator": {
      "type": "object",
      "minProperties": 1
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "threshold",
          "evidence",
          "recorded_at",
          "exposure"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "threshold": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "recorded_at": {
            "type": "string",
            "minLength": 1
          },
          "exposure": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decisions": {
      "type": "array"
    },
    "commit_preference": {
      "enum": [
        "yes",
        "no"
      ]
    },
    "next_step": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "brief",
          "output",
          "status",
          "inputs",
          "note"
        ],
        "properties": {
          "brief": {
            "type": "string",
            "pattern": "^[0-9]{2,3}$"
          },
          "output": {
            "type": "string",
            "pattern": "^(reports/)?[A-Z][A-Z0-9-]*\\.md$"
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "complete",
              "reused",
              "null",
              "blocked",
              "failed",
              "stale",
              "skipped"
            ]
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "note": {
            "type": "string"
          },
          "report_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source": {
            "type": "object",
            "required": [
              "url",
              "retrieved_at",
              "sha256"
            ],
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "retrieved_at": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "complete",
                    "reused",
                    "null"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "report_sha256",
                "source"
              ]
            }
          }
        ]
      }
    }
  }
}
